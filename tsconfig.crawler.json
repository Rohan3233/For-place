{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node10",
    "lib": ["ES2020", "dom"],
    "outDir": "dist-crawler",
    "rootDir": "lib/crawler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx"
  },
  "include": ["lib/crawler/**/*.ts", "lib/crawler/**/*.tsx"]
}
